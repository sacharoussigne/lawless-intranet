# Copy to .env when running the server outside Docker: pnpm --filter realtime dev:server
WS_PORT=3007
INTERNAL_PORT=3008
# Browser origins allowed to open a websocket (comma-separated). Empty = any (dev only).
ALLOWED_ORIGINS=http://dispensary.localhost:3000,http://localhost:3000
# Same value as REALTIME_TOKEN_SECRET in apps/dispensary/.env (min. 16 chars)
REALTIME_TOKEN_SECRET=
# Same value as REALTIME_INTERNAL_SECRET in apps/agenda/.env (min. 16 chars)
REALTIME_INTERNAL_SECRET=
