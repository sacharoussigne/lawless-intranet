# Optional in dev: everything defaults to localhost (ports 3007/3008, any origin, built-in dev secrets).
# Required in production (see docker-compose.yml / docker/.env.example).
# WS_PORT=3007
# INTERNAL_PORT=3008
# ALLOWED_ORIGINS=http://business.lawless.localhost:3000,http://dispensary.lawless.localhost:3000,http://shelter.lawless.localhost:3006
# REALTIME_TOKEN_SECRET=      # same value as apps/dispensary (min. 16 chars)
# REALTIME_INTERNAL_SECRET=   # same value as apps/agenda (min. 16 chars)
