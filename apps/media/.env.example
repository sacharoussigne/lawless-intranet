DATABASE_URL="postgresql://user:password@localhost:XXXX/lawless_media"
AUTH_URL=http://localhost:3001
# Shared with the host apps (shelter, dispensary): every route requires it
MEDIA_INTERNAL_SECRET=

# S3 storage (dev: a dedicated dev bucket). Without S3_BUCKET/S3_REGION the
# service still starts, but uploads and previews are disabled.
S3_BUCKET=
S3_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, for S3-compatible storage (MinIO, Scaleway...)
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Optional (default 20)
# MEDIA_MAX_FILE_SIZE_MB=20

# Realtime websocket server (optional in dev: defaults to http://localhost:3008 + dev secret)
# REALTIME_INTERNAL_URL=http://localhost:3008
# REALTIME_INTERNAL_SECRET=
