# Dev: apps on subdomains of lawless.localhost (shared SSO cookie, business hosts),
# see docs/SSO-DEV.md. Without subdomains, use http://localhost:<port> everywhere.
DATABASE_URL="postgresql://user:password@localhost:XXXX/lawless_auth"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://auth.lawless.localhost:3001
NEXT_PUBLIC_AUTH_URL=http://auth.lawless.localhost:3001
# Main URL of the business app (default landing page after login)
DISPENSARY_URL=http://business.lawless.localhost:3000
NEXT_PUBLIC_DISPENSARY_URL=http://business.lawless.localhost:3000
SHELTER_URL=http://shelter.lawless.localhost:3006
NEXT_PUBLIC_SHELTER_URL=http://shelter.lawless.localhost:3006
# Shared SSO cookie: a bare .localhost is refused by browsers, hence .lawless.localhost.
# Every app on a subdomain of it is trusted (auth, dispensary, business, gs, shelter...).
AUTH_COOKIE_DOMAIN=.lawless.localhost

# Discord OAuth: add http://auth.lawless.localhost:3001/api/auth/callback/discord to the app's redirects
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

ACCESS_ON_CREATE=

AUTH_INTERNAL_SECRET=
