generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Shelter {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String?

  members         ShelterMember[]
  rolePermissions ShelterRolePermission[]
  settings        AppSettings?
  animalSpecies   AnimalSpecies[]

  @@index([createdById])
  @@map("shelter")
}

model ShelterMember {
  id          String   @id @default(uuid())
  shelterId   String
  userId      String
  role        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shelter     Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  permissions ShelterMemberPermission[]

  @@unique([shelterId, userId])
  @@index([userId])
  @@map("shelter_member")
}

model ShelterRolePermission {
  id        String   @id @default(uuid())
  shelterId String
  role      String
  resource  String
  action    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shelter   Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)

  @@unique([shelterId, role, resource, action])
  @@index([shelterId, role])
  @@map("shelter_role_permission")
}

enum MemberPermissionEffect {
  GRANT
  DENY
}

model ShelterMemberPermission {
  id        String                  @id @default(uuid())
  memberId  String
  resource  String
  action    String
  effect    MemberPermissionEffect
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  member    ShelterMember           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resource, action])
  @@index([memberId])
  @@map("shelter_member_permission")
}

model AppSettings {
  shelterId           String   @id
  shelter             Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  shelterName         String   @default("Refuge")
  featureBankEnabled  Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("app_settings")
}

model AnimalSpecies {
  id          String   @id @default(uuid())
  shelterId   String
  name        String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shelter     Shelter  @relation(fields: [shelterId], references: [id], onDelete: Cascade)
  subspecies  AnimalSubspecies[]

  @@unique([shelterId, name])
  @@index([shelterId, sortOrder])
  @@map("animal_species")
}

model AnimalSubspecies {
  id                      String                 @id @default(uuid())
  speciesId               String
  name                    String
  sortOrder               Int                    @default(0)
  shelterPurchasePrice    Decimal?               @db.Decimal(10, 2)
  animalierPurchasePrice  Decimal?               @db.Decimal(10, 2)
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  species                 AnimalSpecies          @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  variants                AnimalSpeciesVariant[]

  @@unique([speciesId, name])
  @@index([speciesId, sortOrder])
  @@map("animal_subspecies")
}

model AnimalSpeciesVariant {
  id           String           @id @default(uuid())
  subspeciesId String
  label        String           @db.VarChar(255)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  subspecies   AnimalSubspecies @relation(fields: [subspeciesId], references: [id], onDelete: Cascade)

  @@unique([subspeciesId, label])
  @@index([subspeciesId, sortOrder])
  @@map("animal_species_variant")
}
