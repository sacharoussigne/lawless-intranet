# Dev: apps on subdomains of lawless.localhost (shared SSO cookie, business hosts),
# see docs/SSO-DEV.md. Without subdomains, use http://localhost:<port> everywhere.
DATABASE_URL="postgresql://user:password@localhost:XXXXX/lawless_shelter"
# Browser login pages (must be the auth subdomain, for the shared cookie)
NEXT_PUBLIC_AUTH_URL=http://auth.lawless.localhost:3001
# Server-to-server calls to auth
AUTH_URL=http://localhost:3001
AUTH_INTERNAL_SECRET=
BANK_URL=http://localhost:3004
BANK_INTERNAL_SECRET=
DOCUMENTS_URL=http://localhost:3002
DOCUMENTS_INTERNAL_SECRET=
NEXT_PUBLIC_APP_URL=http://shelter.lawless.localhost:3006
TZ=UTC
# Media library service (apps/media)
MEDIA_URL=http://localhost:3009
MEDIA_INTERNAL_SECRET=
# Protects the follow-up reminders cron route (api/cron/follow-ups)
FOLLOW_UP_CRON_SECRET=

# Realtime websocket server (apps/realtime). Optional in dev (defaults: ws://localhost:3007,
# http://localhost:3008 and dev secrets)
# REALTIME_PUBLIC_URL=ws://localhost:3007
# REALTIME_TOKEN_SECRET=
# REALTIME_INTERNAL_URL=http://localhost:3008
# REALTIME_INTERNAL_SECRET=
