generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccessType {
  READ
  WRITE
}

model Template {
  id          String   @id @default(uuid())
  type        String
  scopeId     String
  ownerId     String?
  createdById String
  name        String
  description String?
  content     String
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  accesses    TemplateAccess[]

  @@index([type, scopeId])
  @@index([ownerId])
  @@index([createdById])
  @@map("template")
}

model TemplateAccess {
  id         String     @id @default(uuid())
  templateId String
  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  userId     String
  accessType AccessType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([templateId, userId])
  @@index([userId])
  @@map("template_access")
}

model Document {
  id        String   @id @default(uuid())
  type      String
  scopeId   String
  ownerId   String
  name      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  accesses  DocumentAccess[]

  @@index([type, scopeId])
  @@index([ownerId])
  @@index([createdAt])
  @@map("document")
}

model DocumentAccess {
  id         String     @id @default(uuid())
  documentId String
  document   Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId     String
  accessType AccessType
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@unique([documentId, userId])
  @@index([userId])
  @@map("document_access")
}
