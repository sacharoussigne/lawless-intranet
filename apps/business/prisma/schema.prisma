generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //   url      = env("DATABASE_URL")
}

/// Kind of business: decides its modules, default roles and branding (lib/businessTypes).
enum BusinessType {
  DISPENSARY
}

model Business {
  id          String       @id @default(uuid())
  slug        String       @unique
  name        String
  type        BusinessType @default(DISPENSARY)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdById String?

  members                  BusinessMember[]
  rolePermissions          BusinessRolePermission[]
  settings                 AppSettings?
  payrollWeeklyReports     PayrollWeeklyReport[]
  businessWeeklyActivities BusinessWeeklyActivity[]
  people                   BusinessPerson[]
  cabinets                 Cabinet[]
  payrollSalaryTypes       PayrollSalaryType[]

  @@index([createdById])
  @@map("dispensary")
}

model BusinessMember {
  id          String                     @id @default(uuid())
  businessId  String                     @map("dispensaryId")
  userId      String
  role        String
  description String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  business    Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  permissions BusinessMemberPermission[]

  @@unique([businessId, userId])
  @@index([userId])
  @@map("dispensary_member")
}

model BusinessRolePermission {
  id         String   @id @default(uuid())
  businessId String   @map("dispensaryId")
  role       String
  resource   String
  action     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, role, resource, action])
  @@index([businessId, role])
  @@map("dispensary_role_permission")
}

enum MemberPermissionEffect {
  GRANT
  DENY
}

model BusinessMemberPermission {
  id        String                 @id @default(uuid())
  memberId  String
  resource  String
  action    String
  effect    MemberPermissionEffect
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  member    BusinessMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, resource, action])
  @@index([memberId])
  @@map("dispensary_member_permission")
}

model PayrollWeeklyReport {
  id           String   @id @default(uuid())
  businessId   String   @map("dispensaryId")
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  weekStart    DateTime
  weekEnd      DateTime
  reportType   String   @default("Employés")
  resultJson   Json?
  errorMessage String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([businessId, weekStart, reportType])
  @@index([createdById])
  @@index([weekStart])
  @@index([businessId])
  @@index([businessId, weekStart(sort: Desc)])
  @@map("payroll_weekly_report")
}

model UserUiPreferences {
  id     String @id @default(uuid())
  userId String @unique

  lowStockCraftableBg String  @default("#fff3cd")
  lowStockNormalBg    String  @default("#f8d7da")
  okStockBg           String?
  unknownStockBg      String?

  doneTodayBadgeBg String?

  /// Interface theme id (src/lib/themes), e.g. "apothecary" or "nuit".
  theme String @default("apothecary")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("user_ui_preferences")
}

model AppSettings {
  businessId                        String   @id @map("dispensaryId")
  business                          Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessName                      String   @default("Saint-Denis") @map("dispensaryName")
  featureStockEnabled               Boolean  @default(true)
  featureBankEnabled                Boolean  @default(true)
  featureOrdersEnabled              Boolean  @default(true)
  featureSearchEnabled              Boolean  @default(true)
  featureMailsEnabled               Boolean  @default(true)
  featurePayrollEnabled             Boolean  @default(true)
  featureWeeklyActivityEnabled      Boolean  @default(true) @map("featureWeeklyDispensaryActivityEnabled")
  featureAgendaEnabled              Boolean  @default(true)
  featureCabinetEnabled             Boolean  @default(true)
  featureSalesEnabled               Boolean  @default(true)
  featureMediaEnabled               Boolean  @default(true)
  weeklyActivityChestDaysVisible    Boolean  @default(true)
  weeklyActivityPresenceDaysVisible Boolean  @default(true)
  /// Weekly activity counters of the business type: key → enabled (a missing key is enabled).
  weeklyActivityCounters            Json     @default("{}")
  /// Paid per patient cared for (payroll), for every salary type.
  payrollPatientCareUsd             Decimal  @default(0.3) @db.Decimal(10, 2)
  createdAt                         DateTime @default(now())
  updatedAt                         DateTime @updatedAt

  @@map("app_settings")
}

enum BusinessWeeklyActivityHistoryAction {
  CREATE
  DELETE
  UPDATE
  INCREMENT_CHEST
  DECREMENT_CHEST
  UPDATE_CHEST_DAYS
  UPDATE_PRESENCE_DAYS
  /// Counter of the business type (`counterKey`).
  INCREMENT_COUNTER
  DECREMENT_COUNTER
  /// Legacy: per-counter actions, migrated to INCREMENT_/DECREMENT_COUNTER.
  INCREMENT_SHERIFF
  DECREMENT_SHERIFF
  INCREMENT_PALEFRENIER
  DECREMENT_PALEFRENIER
  INCREMENT_PATIENTS
  DECREMENT_PATIENTS
  INCREMENT_INFUSIONS
  DECREMENT_INFUSIONS
  INCREMENT_POPPY_MILK
  DECREMENT_POPPY_MILK

  @@map("DispensaryWeeklyActivityHistoryAction")
}

enum BusinessWeeklyActivityHistorySource {
  INTRANET
  DISCORD_BOT

  @@map("DispensaryWeeklyActivityHistorySource")
}

model BusinessWeeklyActivity {
  id            String                          @id @default(uuid())
  businessId    String                          @map("dispensaryId")
  business      Business                        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  periodStart   DateTime
  periodEnd     DateTime
  displayName   String
  discordUserId String
  userId        String?
  chestDays     Json
  presenceDays  Json
  /// Counters of the business type (lib/businessTypes `weeklyCounters`): key → value, a missing key is 0.
  counters      Json                            @default("{}")
  createdAt     DateTime                        @default(now())
  updatedAt     DateTime                        @updatedAt
  history       BusinessWeeklyActivityHistory[]

  @@unique([businessId, discordUserId, periodStart, periodEnd])
  @@index([discordUserId])
  @@index([userId])
  @@index([businessId])
  @@index([businessId, periodStart])
  @@map("dispensary_weekly_activity")
}

model BusinessWeeklyActivityHistory {
  id                    String                              @id @default(uuid())
  activityId            String?
  activity              BusinessWeeklyActivity?             @relation(fields: [activityId], references: [id], onDelete: SetNull)
  action                BusinessWeeklyActivityHistoryAction
  source                BusinessWeeklyActivityHistorySource
  actorUserId           String?
  actorDiscordUserId    String?
  /// Platform admin acting as `actorUserId` (impersonation), if any.
  actorImpersonatedById String?
  previousValues        Json?
  nextValues            Json?
  /// Counter of INCREMENT_/DECREMENT_COUNTER.
  counterKey            String?
  createdAt             DateTime                            @default(now())

  @@index([activityId])
  @@index([activityId, createdAt])
  @@index([actorUserId])
  @@map("dispensary_weekly_activity_history")
}

/// A person of the RP server, keyed by its Discord ID, shared by every business
/// (docs/MULTI-BUSINESS.md): with or without an intranet account.
model Person {
  id               String           @id @default(uuid())
  discordUserId    String           @unique
  /// Latest name sent by the bot or the activity form (history, fallback).
  lastDisplayName  String
  /// Name set by hand (Gestion › Personnes): shown everywhere, never overwritten by the bot.
  fixedDisplayName String?
  /// RP bank account: payroll pays to this number, one person per number.
  accountNumber    Int?             @unique
  /// SSO account linked to this Discord ID, filled as soon as one exists.
  userId           String?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  businesses       BusinessPerson[]

  @@index([userId])
  @@map("person")
}

/// A person known by a business (Gestion › Personnes, weekly activity, payroll).
model BusinessPerson {
  id           String               @id @default(uuid())
  businessId   String
  business     Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  personId     String
  person       Person               @relation(fields: [personId], references: [id], onDelete: Cascade)
  /// Grade in this business (payroll).
  role         String?
  /// Salary type in this business (payroll); none = the business default.
  salaryTypeId String?
  salaryType   PayrollSalaryType?   @relation(fields: [salaryTypeId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  employments  BusinessEmployment[]

  @@unique([businessId, personId])
  @@index([personId])
  @@index([salaryTypeId])
  @@map("business_person")
}

enum EmploymentEndReason {
  RESIGNED
  DISMISSED
  OTHER
}

enum EmploymentEventType {
  HIRED
  ROLE_CHANGED
  LEFT
}

/// A stay of a person in a business (staff register): from hiring to leaving.
/// A person can come and go several times; at most one stay is open (checked by the actions).
model BusinessEmployment {
  id               String                    @id @default(uuid())
  businessPersonId String
  businessPerson   BusinessPerson            @relation(fields: [businessPersonId], references: [id], onDelete: Cascade)
  /// Latest grade of the stay (the open stay mirrors `BusinessPerson.role`).
  role             String?
  startedAt        DateTime
  /// `null`: still employed.
  endedAt          DateTime?
  endReason        EmploymentEndReason?
  createdById      String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  events           BusinessEmploymentEvent[]

  @@index([businessPersonId, startedAt])
  @@map("business_employment")
}

/// What happened during a stay (hiring, grade change, leaving): the person's history.
model BusinessEmploymentEvent {
  id           String               @id @default(uuid())
  employmentId String
  employment   BusinessEmployment   @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  type         EmploymentEventType
  /// Grade before the event (grade change, leaving).
  fromRole     String?
  /// Grade after the event (hiring, grade change).
  toRole       String?
  /// Leaving only.
  endReason    EmploymentEndReason?
  note         String?
  occurredAt   DateTime
  createdById  String?
  createdAt    DateTime             @default(now())

  @@index([employmentId, occurredAt])
  @@map("business_employment_event")
}

/// Salary type of a business (payroll): what a person is paid per caisse.
model PayrollSalaryType {
  id                    String           @id @default(uuid())
  businessId            String
  business              Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  label                 String
  caisseUnitUsd         Decimal          @db.Decimal(10, 2)
  /// Used for people without a salary type and as the report's caisse price.
  isDefault             Boolean          @default(false)
  /// Same, in the « Préparateurs de caisse » report (none: the default above).
  isCashPreparerDefault Boolean          @default(false)
  sortOrder             Int              @default(0)
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  people                BusinessPerson[]

  @@unique([businessId, label])
  @@index([businessId])
  @@map("payroll_salary_type")
}

enum CabinetAccessLevel {
  OWNER
  WRITE
  READ
}

model Cabinet {
  id              String           @id @default(uuid())
  businessId      String           @map("dispensaryId")
  business        Business         @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  formSchemas     Json
  displaySettings Json             @default("{}")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  members         CabinetMember[]
  patients        CabinetPatient[]

  @@index([businessId])
  @@map("cabinet")
}

model CabinetMember {
  id          String             @id @default(uuid())
  cabinetId   String
  cabinet     Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  userId      String
  accessLevel CabinetAccessLevel
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([cabinetId, userId])
  @@index([userId])
  @@map("cabinet_member")
}

model CabinetPatient {
  id               String        @id @default(uuid())
  cabinetId        String
  cabinet          Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  birthDate        DateTime?
  emergencyContact String?
  customValues     Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  careEpisodes     CareEpisode[]

  @@index([cabinetId])
  @@index([cabinetId, lastName, firstName])
  @@map("cabinet_patient")
}

model CareEpisode {
  id            String         @id @default(uuid())
  patientId     String
  patient       CabinetPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  motif         String
  startedAt     DateTime
  customValues  Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  consultations Consultation[]

  @@index([patientId])
  @@index([patientId, startedAt])
  @@map("care_episode")
}

model Consultation {
  id            String      @id @default(uuid())
  careEpisodeId String
  careEpisode   CareEpisode @relation(fields: [careEpisodeId], references: [id], onDelete: Cascade)
  date          DateTime
  customValues  Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([careEpisodeId, date])
  @@map("consultation")
}

enum AppLogLevel {
  INFO
  WARN
  ERROR
}

enum AppLogKind {
  ACTION
  ERROR
  BOT_REQUEST
}

enum AppLogSource {
  INTRANET
  DISCORD_BOT
  SYSTEM
}

/// App-wide log (platform admins, /platform/logs): server errors of every feature,
/// every action of sensitive features, every Discord bot request. See docs/APP-LOGS.md.
model AppLog {
  id               String       @id @default(uuid())
  createdAt        DateTime     @default(now())
  level            AppLogLevel
  kind             AppLogKind
  /// Feature key (AppFeatureKey, or "platform" / "unknown").
  feature          String
  /// Stable event name, e.g. weeklyActivity.chest.mark, bot.caisse.
  event            String
  /// success | noop | denied | invalid | failure
  outcome          String?
  message          String
  source           AppLogSource
  /// No foreign key: logs outlive a deleted dispensary.
  businessId       String?      @map("dispensaryId")
  userId           String?
  discordUserId    String?
  /// Platform admin acting as `userId` (impersonation), if any.
  impersonatedById String?
  httpStatus       Int?
  durationMs       Int?
  /// API route, or the page an action was called from.
  path             String?
  /// Id of the object the action touched (created, updated, deleted…), when known.
  targetId         String?
  context          Json?
  error            Json?

  @@index([createdAt(sort: Desc)])
  @@index([businessId, createdAt(sort: Desc)])
  @@index([feature, createdAt(sort: Desc)])
  @@index([level, createdAt(sort: Desc)])
  @@index([discordUserId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([targetId, createdAt(sort: Desc)])
  @@map("app_logs")
}
