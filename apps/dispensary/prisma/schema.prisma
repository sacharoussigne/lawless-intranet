generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  //   url      = env("DATABASE_URL")
}

model Dispensary {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String?

  members     DispensaryMember[]
  settings    AppSettings?
  categoryItems CategoryItem[]
  items       Item[]
  chests      Chest[]
  companies   Company[]
  companyGroups CompanyGroup[]
  individualCustomers IndividualCustomer[]
  orders      Order[]
  orderMailTemplateAssignments OrderMailTemplateAssignment[]
  bankAccounts BankAccount[]
  transactionNameSuggestions TransactionNameSuggestion[]
  transactionDescriptionSuggestions TransactionDescriptionSuggestion[]
  payrollWeeklyReports PayrollWeeklyReport[]
  dispensaryWeeklyActivities DispensaryWeeklyActivity[]
  craftRecipes CraftRecipe[]
  agendas Agenda[]
  cabinets Cabinet[]

  @@index([createdById])
  @@map("dispensary")
}

model DispensaryMember {
  id           String     @id @default(uuid())
  dispensaryId String
  userId       String
  role         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)

  @@unique([dispensaryId, userId])
  @@index([userId])
  @@map("dispensary_member")
}

model PayrollWeeklyReport {
  id              String   @id @default(uuid())
  dispensaryId    String
  dispensary      Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  weekStart       DateTime
  weekEnd         DateTime
  reportType      String   @default("Employés")
  resultJson      Json?
  errorMessage    String?
  createdById     String
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([dispensaryId, weekStart, reportType])
  @@index([createdById])
  @@index([weekStart])
  @@index([dispensaryId])
  @@index([dispensaryId, weekStart(sort: Desc)])
  @@map("payroll_weekly_report")
}

model UserUiPreferences {
  id                   String   @id @default(uuid())
  userId               String   @unique

  lowStockCraftableBg  String   @default("#fff3cd")
  lowStockNormalBg     String   @default("#f8d7da")
  okStockBg            String?
  unknownStockBg       String?

  doneTodayBadgeBg     String?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
  @@map("user_ui_preferences")
}

model AppSettings {
  dispensaryId                 String   @id
  dispensary                   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  dispensaryName               String   @default("Saint-Denis")
  featureStockEnabled          Boolean  @default(true)
  featureBankEnabled           Boolean  @default(true)
  featureOrdersEnabled         Boolean  @default(true)
  featureSearchEnabled         Boolean  @default(true)
  featureMailsEnabled          Boolean  @default(true)
  featurePayrollEnabled        Boolean  @default(true)
  featureWeeklyDispensaryActivityEnabled Boolean @default(true)
  featureAgendaEnabled                 Boolean @default(true)
  featureCabinetEnabled                Boolean @default(true)
  weeklyActivityChestDaysVisible       Boolean @default(true)
  weeklyActivityPresenceDaysVisible    Boolean @default(true)
  weeklyActivityPatientsVisible        Boolean @default(true)
  weeklyActivitySherifsVisible         Boolean @default(true)
  weeklyActivityInfusionsVisible       Boolean @default(true)
  weeklyActivityPoppyMilkVisible       Boolean @default(true)
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  @@map("app_settings")
}

model CategoryItem {
  id            String     @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name          String
  color         String     @default("#ffffff")
  order         Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  items         Item[]
  chestStockCheckCategories ChestStockCheckCategory[]

  @@index([dispensaryId])
  @@map("category_item")
}

model Item {
  id             String            @id @default(uuid())
  dispensaryId   String
  dispensary     Dispensary        @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  minimalQuantity  Int
  isCraftable    Boolean           @default(false)
  isEnabled      Boolean           @default(true)
  canBeSold      Boolean           @default(false)
  price          Decimal?           @db.Decimal(10, 2)
  weight         Float?
  categoryId     String
  category       CategoryItem      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  companyGroupId String?
  companyGroup   CompanyGroup?     @relation(fields: [companyGroupId], references: [id], onDelete: SetNull)
  order          Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  stockHistory   StockHistory[]
  stockItemMovements StockItemMovement[]
  craftRecipes   CraftRecipe[]     @relation("CraftedItem")
  usedInRecipes  CraftRecipeItem[] @relation("UsedItem")
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([companyGroupId])
  @@index([dispensaryId])
  @@map("item")
}

model Chest {
  id            String         @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary     @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  isEnabled     Boolean        @default(true)
  order         Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  stockHistory StockHistory[]
  stockCheckConfig ChestStockCheckConfig?
  stockItemMovements StockItemMovement[] @relation("MovementChest")
  stockItemMovementDestinations StockItemMovement[] @relation("MovementDestinationChest")

  @@index([dispensaryId])
  @@map("chest")
}

model ChestStockCheckConfig {
  id        String   @id @default(uuid())
  chestId   String   @unique
  isEnabled Boolean  @default(true)
  chest     Chest    @relation(fields: [chestId], references: [id], onDelete: Cascade)
  categories ChestStockCheckCategory[]

  @@index([chestId])
  @@map("chest_stock_check_config")
}

model ChestStockCheckCategory {
  id        String   @id @default(uuid())
  configId  String
  categoryId String
  config    ChestStockCheckConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  category  CategoryItem          @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([configId, categoryId])
  @@index([configId])
  @@index([categoryId])
  @@map("chest_stock_check_category")
}

model StockHistory {
  id        String   @id @default(uuid())
  itemId    String
  chestId   String
  quantity  Int
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  chest     Chest    @relation(fields: [chestId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())

  @@index([itemId])
  @@index([chestId])
  @@index([timestamp])
  @@index([itemId, chestId, timestamp])
  @@map("stock_history")
}

enum StockMovementKind {
  MANUAL_FIRST_COUNT
  MANUAL_ADJUST
  CRAFT_CONSUME
  CRAFT_PRODUCE
  TRANSFER_OUT
  TRANSFER_IN
  OVERWRITE
}

model StockItemMovement {
  id                 String            @id @default(uuid())
  itemId             String
  chestId            String?
  destinationChestId String?
  quantity           Int
  kind               StockMovementKind
  userId             String?
  note               String?
  createdAt          DateTime          @default(now())

  item             Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  chest            Chest? @relation("MovementChest", fields: [chestId], references: [id], onDelete: SetNull)
  destinationChest Chest? @relation("MovementDestinationChest", fields: [destinationChestId], references: [id], onDelete: SetNull)

  @@index([itemId, createdAt])
  @@index([createdAt])
  @@index([chestId, createdAt])
  @@index([itemId, chestId, createdAt])
  @@map("stock_item_movement")
}

model Company {
  id            String                @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary            @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  companyGroups CompanyGroupCompany[]
  orders        Order[]

  @@index([dispensaryId])
  @@map("company")
}

model CraftRecipe {
  id                String            @id @default(uuid())
  dispensaryId      String
  dispensary        Dispensary        @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  craftedItemId     String
  craftedItem       Item              @relation("CraftedItem", fields: [craftedItemId], references: [id], onDelete: Cascade)
  quantity          Int
  isEnabled         Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  ingredients       CraftRecipeItem[]

  @@index([craftedItemId])
  @@index([dispensaryId])
  @@map("craft_recipe")
}

model CraftRecipeItem {
  id            String      @id @default(uuid())
  craftRecipeId String
  craftRecipe   CraftRecipe @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)
  usedItemId    String
  usedItem      Item        @relation("UsedItem", fields: [usedItemId], references: [id], onDelete: Cascade)
  quantity      Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([craftRecipeId])
  @@index([usedItemId])
  @@map("craft_recipe_item")
}

model IndividualCustomer {
  id            String     @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name          String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  orders        Order[]

  @@index([dispensaryId])
  @@map("individual_customer")
}

model CompanyGroup {
  id            String                @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary            @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         Item[]
  companies     CompanyGroupCompany[]
  orders        Order[]

  @@index([dispensaryId])
  @@map("company_group")
}

model CompanyGroupCompany {
  id             String       @id @default(uuid())
  companyGroupId String
  companyGroup   CompanyGroup @relation(fields: [companyGroupId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([companyGroupId, companyId])
  @@index([companyGroupId])
  @@index([companyId])
  @@map("company_group_company")
}

enum OrderStatus {
  DRAFT
  LETTER_SENT
  PROCESSING
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  INCOMING
  OUTGOING
}

model Order {
  id                     String               @id @default(uuid())
  dispensaryId           String
  dispensary             Dispensary           @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name                   String
  status                 OrderStatus          @default(DRAFT)
  type                   OrderType            @default(INCOMING)
  details                String?
  price                  Decimal?             @db.Decimal(10, 2)
  companyId              String?
  company                Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyGroupId         String?
  companyGroup           CompanyGroup?        @relation(fields: [companyGroupId], references: [id], onDelete: SetNull)
  individualCustomerId   String?
  individualCustomer     IndividualCustomer?  @relation(fields: [individualCustomerId], references: [id], onDelete: SetNull)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  items                  OrderItem[]

  @@index([companyId])
  @@index([companyGroupId])
  @@index([individualCustomerId])
  @@index([status])
  @@index([type])
  @@index([dispensaryId])
  @@index([dispensaryId, createdAt(sort: Desc)])
  @@map("order")
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, itemId])
  @@index([orderId])
  @@index([itemId])
  @@map("order_item")
}

model OrderMailTemplateAssignment {
  id              String         @id @default(uuid())
  dispensaryId    String
  dispensary      Dispensary     @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  orderType       OrderType
  orderStatus     OrderStatus
  templateId      String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([dispensaryId, orderType, orderStatus])
  @@index([templateId])
  @@index([orderType, orderStatus])
  @@map("order_mail_template_assignment")
}

enum BankAccountAccessType {
  READ
  WRITE
}

model BankAccount {
  id            String     @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name      String
  ownerId   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accesses  BankAccountAccess[]
  weeks     BankAccountWeek[]

  @@index([ownerId])
  @@index([dispensaryId])
  @@map("bank_account")
}

model BankAccountAccess {
  id        String   @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  userId    String
  accessType BankAccountAccessType
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, userId])
  @@index([accountId])
  @@index([userId])
  @@map("bank_account_access")
}

model BankAccountWeek {
  id        String   @id @default(uuid())
  accountId String
  account   BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  weekStart DateTime
  weekEnd   DateTime
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  transactions BankTransaction[]

  @@unique([accountId, weekStart])
  @@index([accountId])
  @@index([weekStart])
  @@map("bank_account_week")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER_IN
  TRANSFER_OUT
}

model BankTransaction {
  id          String   @id @default(uuid())
  weekId      String
  week        BankAccountWeek @relation(fields: [weekId], references: [id], onDelete: Cascade)
  date        DateTime
  type        TransactionType
  name        String
  description String?
  amount      Decimal  @db.Decimal(10, 2)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([weekId])
  @@index([date])
  @@map("bank_transaction")
}

model TransactionNameSuggestion {
  id            String     @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dispensaryId, value])
  @@map("transaction_name_suggestion")
}

model TransactionDescriptionSuggestion {
  id            String     @id @default(uuid())
  dispensaryId  String
  dispensary    Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dispensaryId, value])
  @@map("transaction_description_suggestion")
}

enum DispensaryWeeklyActivityHistoryAction {
  CREATE
  DELETE
  UPDATE
  INCREMENT_CHEST
  DECREMENT_CHEST
  UPDATE_CHEST_DAYS
  UPDATE_PRESENCE_DAYS
  INCREMENT_SHERIFF
  DECREMENT_SHERIFF
  INCREMENT_PALEFRENIER
  DECREMENT_PALEFRENIER
  INCREMENT_PATIENTS
  DECREMENT_PATIENTS
  INCREMENT_INFUSIONS
  DECREMENT_INFUSIONS
  INCREMENT_POPPY_MILK
  DECREMENT_POPPY_MILK
}

enum DispensaryWeeklyActivityHistorySource {
  INTRANET
  DISCORD_BOT
}

model DispensaryWeeklyActivity {
  id                   String   @id @default(uuid())
  dispensaryId         String
  dispensary           Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  periodStart          DateTime
  periodEnd            DateTime
  displayName          String
  discordUserId        String
  userId               String?
  chestDays            Json
  presenceDays         Json
  sherifCount          Int      @default(0)
  patientsCount        Int      @default(0)
  infusionsCount       Int      @default(0)
  poppyMilkCount       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  history              DispensaryWeeklyActivityHistory[]

  @@unique([dispensaryId, discordUserId, periodStart, periodEnd])
  @@index([discordUserId])
  @@index([userId])
  @@index([dispensaryId])
  @@index([dispensaryId, periodStart])
  @@map("dispensary_weekly_activity")
}

model DispensaryWeeklyActivityHistory {
  id                 String                            @id @default(uuid())
  activityId         String?
  activity           DispensaryWeeklyActivity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  action             DispensaryWeeklyActivityHistoryAction
  source             DispensaryWeeklyActivityHistorySource
  actorUserId        String?
  actorDiscordUserId String?
  previousValues     Json?
  nextValues         Json?
  createdAt          DateTime                          @default(now())

  @@index([activityId])
  @@index([activityId, createdAt])
  @@index([actorUserId])
  @@map("dispensary_weekly_activity_history")
}

enum AgendaAccessLevel {
  OWNER
  WRITE
  READ
}

model Agenda {
  id           String   @id @default(uuid())
  dispensaryId String
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      AgendaMember[]
  events       AgendaEvent[]
  todoLists    AgendaTodoList[]

  @@index([dispensaryId])
  @@map("agenda")
}

model AgendaMember {
  id          String            @id @default(uuid())
  agendaId    String
  agenda      Agenda            @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  userId      String
  accessLevel AgendaAccessLevel
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([agendaId, userId])
  @@index([userId])
  @@map("agenda_member")
}

model AgendaEvent {
  id          String   @id @default(uuid())
  agendaId    String
  agenda      Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  participants AgendaEventParticipant[]
  todoTasks   AgendaEventTodoTask[]

  @@index([agendaId, startAt])
  @@map("agenda_event")
}

model AgendaEventParticipant {
  id      String      @id @default(uuid())
  eventId String
  event   AgendaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  createdAt DateTime  @default(now())

  @@unique([eventId, userId])
  @@index([userId])
  @@map("agenda_event_participant")
}

model AgendaTodoList {
  id        String   @id @default(uuid())
  agendaId  String
  agenda    Agenda   @relation(fields: [agendaId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  categories AgendaTodoCategory[]

  @@index([agendaId])
  @@map("agenda_todo_list")
}

model AgendaTodoCategory {
  id        String   @id @default(uuid())
  listId    String
  list      AgendaTodoList @relation(fields: [listId], references: [id], onDelete: Cascade)
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     AgendaTodoTask[]

  @@index([listId])
  @@map("agenda_todo_category")
}

model AgendaTodoTask {
  id          String   @id @default(uuid())
  categoryId  String
  category    AgendaTodoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
  @@map("agenda_todo_task")
}

model AgendaEventTodoTask {
  id          String   @id @default(uuid())
  eventId     String
  event       AgendaEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  completed   Boolean  @default(false)
  completedAt DateTime?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId])
  @@map("agenda_event_todo_task")
}

enum CabinetAccessLevel {
  OWNER
  WRITE
  READ
}

model Cabinet {
  id           String   @id @default(uuid())
  dispensaryId String
  dispensary   Dispensary @relation(fields: [dispensaryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  formSchemas  Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  members      CabinetMember[]
  patients     CabinetPatient[]

  @@index([dispensaryId])
  @@map("cabinet")
}

model CabinetMember {
  id          String             @id @default(uuid())
  cabinetId   String
  cabinet     Cabinet            @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  userId      String
  accessLevel CabinetAccessLevel
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([cabinetId, userId])
  @@index([userId])
  @@map("cabinet_member")
}

model CabinetPatient {
  id               String        @id @default(uuid())
  cabinetId        String
  cabinet          Cabinet       @relation(fields: [cabinetId], references: [id], onDelete: Cascade)
  firstName        String
  lastName         String
  birthDate        DateTime?
  emergencyContact String?
  customValues     Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  careEpisodes     CareEpisode[]

  @@index([cabinetId])
  @@index([cabinetId, lastName, firstName])
  @@map("cabinet_patient")
}

model CareEpisode {
  id            String         @id @default(uuid())
  patientId     String
  patient       CabinetPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  motif         String
  startedAt     DateTime
  customValues  Json           @default("{}")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  consultations Consultation[]

  @@index([patientId])
  @@index([patientId, startedAt])
  @@map("care_episode")
}

model Consultation {
  id            String      @id @default(uuid())
  careEpisodeId String
  careEpisode   CareEpisode @relation(fields: [careEpisodeId], references: [id], onDelete: Cascade)
  date          DateTime
  customValues  Json        @default("{}")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([careEpisodeId, date])
  @@map("consultation")
}
