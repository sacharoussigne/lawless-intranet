BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000 # Base URL of your app
NEXT_PUBLIC_API_URL=http://localhost:3000 # Base URL of your app
NEXT_PUBLIC_APP_ENV=dev # dev or prod
TZ=UTC

