COMPOSE_PROJECT_NAME=lawless

# Public URLs (must match VIRTUAL_HOST + https)
AUTH_PUBLIC_URL=https://auth.example.com
DISPENSARY_PUBLIC_URL=https://dispensaire.example.com
DOCUMENTS_PUBLIC_URL=https://documents.example.com
AGENDA_PUBLIC_URL=https://agenda.example.com
BANK_PUBLIC_URL=https://bank.example.com

# nginx-proxy hostnames (must match the public URLs users type in the browser)
AUTH_VIRTUAL_HOST=auth.example.com
DISPENSARY_VIRTUAL_HOST=dispensaire.example.com
DOCUMENTS_VIRTUAL_HOST=documents.example.com
AGENDA_VIRTUAL_HOST=agenda.example.com
BANK_VIRTUAL_HOST=bank.example.com

# Optional comma-separated extra origins for domain migrations
# EXTRA_TRUSTED_ORIGINS=https://dispensary.example.com

# Shared cookie domain for SSO (leading dot for subdomains)
AUTH_COOKIE_DOMAIN=.example.com

# Databases (separate PostgreSQL instances or schemas)
AUTH_DATABASE_URL=postgresql://user:password@db-host:5432/lawless_auth
DISPENSARY_DATABASE_URL=postgresql://user:password@db-host:5432/lawless_dispensary
DOCUMENTS_DATABASE_URL=postgresql://user:password@db-host:5432/lawless_documents
AGENDA_DATABASE_URL=postgresql://user:password@db-host:5432/lawless_agenda
BANK_DATABASE_URL=postgresql://user:password@db-host:5432/lawless_bank

# Auth secrets (same BETTER_AUTH_SECRET if you rotate from legacy)
BETTER_AUTH_SECRET=
AUTH_INTERNAL_SECRET=
# Shared between dispensary (host) and agenda — required for scopeAdmin / create agenda
AGENDA_INTERNAL_SECRET=
# Shared between dispensary (host) and bank — required for from-order / purge-scope
BANK_INTERNAL_SECRET=
BANK_BOT_API_SECRET=
# Shared between dispensary (host) and documents — required for all documents API calls
DOCUMENTS_INTERNAL_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

ACCESS_ON_CREATE=
DISPENSARY_BOT_API_SECRET=

APP_ENV=PROD
TZ=UTC
LETSENCRYPT_DNS_CHALLENGE=true

EXTRA_TRUSTED_ORIGINS= #https://XXXX