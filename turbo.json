{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ],
      "env": [
        "DATABASE_URL",
        "DOCUMENTS_URL",
        "AGENDA_URL",
        "BANK_URL",
        "INVENTORY_URL",
        "MEDIA_URL",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_DISPENSARY_URL",
        "NEXT_PUBLIC_APP_URL",
        "AUTH_URL",
        "BETTER_AUTH_URL",
        "DISPENSARY_URL",
        "NEXT_PUBLIC_SHELTER_URL",
        "SHELTER_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "test": {
      "dependsOn": [
        "^test"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    }
  }
}
