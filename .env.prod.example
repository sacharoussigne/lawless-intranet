# Accès aux bases de PROD pour `pnpm db:pull-prod` (lecture seule). Copier en .env.prod (ignoré par Git).
# Une URL par base ; une base absente est ignorée.
PROD_AUTH_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_auth"
PROD_DISPENSARY_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_dispensary"
PROD_SHELTER_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_shelter"
PROD_DOCUMENTS_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_documents"
PROD_AGENDA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_agenda"
PROD_BANK_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_bank"
PROD_INVENTORY_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_inventory"
PROD_MEDIA_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/lawless_media"
