{
    "name": "lawless-intranet",
    "private": true,
    "packageManager": "pnpm@11.6.0",
    "scripts": {
      "dev": "turbo dev",
      "build": "turbo build",
      "lint": "turbo lint",
      "typecheck": "turbo typecheck",
    "migrate:users-to-auth": "tsx scripts/migrate-users-to-auth.ts",
    "migrate:mails-to-documents": "tsx scripts/migrate-mails-to-documents.ts",
    "migrate:agenda-to-service": "tsx scripts/migrate-agenda-to-agenda-service.ts",
    "migrate:bank-to-service": "tsx scripts/migrate-bank-to-bank-service.ts",
    "migrate:legacy-bank-account": "tsx scripts/migrate-legacy-bank-account-to-bank-service.ts",
    "docker:build:auth": "docker build --build-arg APP_NAME=auth --build-arg APP_PORT=3001 -t lawless-auth .",
    "docker:build:dispensary": "docker build --build-arg APP_NAME=dispensary --build-arg APP_PORT=3000 -t lawless-dispensary .",
    "docker:build:documents": "docker build --build-arg APP_NAME=documents --build-arg APP_PORT=3002 -t lawless-documents .",
    "docker:build:agenda": "docker build --build-arg APP_NAME=agenda --build-arg APP_PORT=3003 -t lawless-agenda .",
    "docker:build:bank": "docker build --build-arg APP_NAME=bank --build-arg APP_PORT=3004 -t lawless-bank .",
      "docker:up": "docker compose --env-file .env.docker up -d --build",
      "docker:down": "docker compose --env-file .env.docker down"
    },
    "devDependencies": {
      "turbo": "^2.5.0",
      "typescript": "^5.9.0",
      "tsx": "^4.21.0",
      "pg": "^8.16.3",
      "@types/pg": "^8.16.0",
      "dotenv": "^17.2.3"
    }
  }