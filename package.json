{
  "name": "lawless-intranet",
  "private": true,
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "clean:next": "bash scripts/clean-next.sh",
    "db:migrate:deploy": "pnpm --filter \"./apps/**\" --workspace-concurrency=1 run db:migrate:deploy",
    "db:migrate:status": "pnpm --filter \"./apps/**\" --workspace-concurrency=1 --no-bail run db:migrate:status",
    "db:generate": "pnpm --filter \"./apps/**\" run db:generate",
    "db:pull-prod": "bash scripts/db-pull-prod.sh",
    "docker:build:auth": "docker build --build-arg APP_NAME=auth --build-arg APP_PORT=3001 -t lawless-auth .",
    "docker:build:business": "docker build --build-arg APP_NAME=business --build-arg APP_PORT=3000 -t lawless-business .",
    "docker:build:documents": "docker build --build-arg APP_NAME=documents --build-arg APP_PORT=3002 -t lawless-documents .",
    "docker:build:agenda": "docker build --build-arg APP_NAME=agenda --build-arg APP_PORT=3003 -t lawless-agenda .",
    "docker:build:bank": "docker build --build-arg APP_NAME=bank --build-arg APP_PORT=3004 -t lawless-bank .",
    "docker:build:inventory": "docker build --build-arg APP_NAME=inventory --build-arg APP_PORT=3005 -t lawless-inventory .",
    "docker:build:shelter": "docker build --build-arg APP_NAME=shelter --build-arg APP_PORT=3006 -t lawless-shelter .",
    "docker:build:media": "docker build --build-arg APP_NAME=media --build-arg APP_PORT=3009 -t lawless-media .",
    "docker:build:realtime": "docker build -f docker/realtime.Dockerfile -t lawless-realtime .",
    "docker:up": "docker compose --env-file .env.docker up -d --build",
    "docker:down": "docker compose --env-file .env.docker down"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "dotenv": "^17.2.3"
  }
}
